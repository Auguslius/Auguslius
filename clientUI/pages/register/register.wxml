<!--pages/register/register.wxml-->
<view class="register-container">
  <!-- 添加背景图 -->
  <image class="bg-image" src="/static/images/background.png" mode="aspectFill"></image>
  
  <!-- 顶部错误提示框 -->
  <view class="top-error-container {{showTopError ? 'show' : ''}}" bindtap="closeTopError">
    <view class="top-error-content">
      <van-icon name="warning-o" class="top-error-icon" />
      <text>{{topErrorMsg}}</text>
      <van-icon name="cross" class="top-error-close" catchtap="closeTopError" />
    </view>
  </view>
  
  <!-- 注册卡片 -->
  <view class="register-card">
    <text class="register-title">用户注册</text>
    
    <!-- 表单部分 -->
    <view class="form-content">
      <!-- 用户名输入框 -->
      <view class="form-item">
        <van-icon name="contact" class="form-icon" />
        <view class="label">用户名</view>
        <input type="text" placeholder="请输入用户名" bindinput="onUsernameInput" value="{{username}}" />
      </view>
      
      <!-- 密码输入框 -->
      <view class="form-item">
        <van-icon name="closed-eye" class="form-icon" />
        <view class="label">密码</view>
        <input type="password" placeholder="请输入密码" bindinput="onPasswordInput" value="{{password}}" />
      </view>
      
      <!-- 确认密码输入框 -->
      <view class="form-item">
        <van-icon name="passed" class="form-icon" />
        <view class="label">确认密码</view>
        <input type="password" placeholder="请再次输入密码" bindinput="onConfirmPasswordInput" value="{{confirmPassword}}" />
      </view>
      
      <!-- 验证码输入框 -->
      <view class="form-item verify-code">
        <van-icon name="shield-o" class="form-icon" />
        <view class="label">验证码</view>
        <input type="text" placeholder="请输入验证码" bindinput="onCodeInput" value="{{code}}" />
        <view class="code-img-wrapper" bindtap="refreshCode">
          <image wx:if="{{image}}" src="data:image/png;base64,{{image}}" mode="aspectFit" class="code-img"></image>
          <view wx:else class="code-loading">加载中...</view>
        </view>
      </view>
      <!-- 将倒计时提示放在验证码行下方右侧 -->
      <view class="code-countdown-tip {{codeExpired ? 'expired' : ''}}">
        <block wx:if="{{codeExpired}}">
          已过期，点击刷新
        </block>
        <block wx:else>
          {{countdown}}秒有效
        </block>
      </view>
      
      <!-- 注册按钮 -->
      <view class="btn-wrapper">
        <button class="register-btn {{isLoading ? 'loading' : ''}}" bindtap="register" disabled="{{isLoading}}">
          <text wx:if="{{isLoading}}">注册中...</text>
          <text wx:else><van-icon name="completed" /> 立即注册</text>
        </button>
      </view>
      
      <!-- 返回登录链接 -->
      <view class="back-to-login" bindtap="backToLogin">
        <text>已有账号？</text><text class="login-text"><van-icon name="arrow-left" /> 返回登录</text>
      </view>
    </view>
  </view>
</view> 