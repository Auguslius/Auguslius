/* pages/profile/my-doctors/my-doctors.wxss */
.page-container {
  min-height: 100vh;
  background-color: #f8fcf9;
  display: flex;
  flex-direction: column;
  position: relative;
}

/* 导航栏 */
.nav-bar {
  background: #fff;
  padding: 20rpx 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  position: relative;
  z-index: 100;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
}

/* 错误提示 */
.error-toast {
  position: fixed;
  top: -100rpx;
  left: 0;
  right: 0;
  z-index: 1000;
  transition: top 0.3s ease;
}

.error-toast.show {
  top: 0;
}

.error-content {
  background-color: #fef0f0;
  color: #f56c6c;
  padding: 20rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.error-content text {
  flex: 1;
  margin: 0 20rpx;
  font-size: 28rpx;
}

/* 未登录状态 */
.login-needed {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 40rpx;
  background: #fff;
  margin: 30rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.login-icon {
  margin-bottom: 40rpx;
}

.login-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 60rpx;
}

.login-button {
  background: #2E8B57;
  color: #fff;
  border: none;
  padding: 20rpx 80rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-icon {
  margin-bottom: 20rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 医生详情 */
.doctor-detail {
  padding: 0 0 80rpx;
}

/* 医生头部信息 */
.doctor-header {
  background: linear-gradient(135deg, #3CB371, #2E8B57);
  padding: 60rpx 40rpx;
  display: flex;
  align-items: center;
  color: #fff;
  box-shadow: 0 4rpx 20rpx rgba(46, 139, 87, 0.3);
}

.doctor-avatar-large {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  margin-right: 30rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border: 4rpx solid rgba(255, 255, 255, 0.6);
}

.doctor-header-info {
  flex: 1;
}

.doctor-name-large {
  font-size: 44rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.doctor-badges {
  display: flex;
  flex-wrap: wrap;
}

.doctor-position-badge, .doctor-status-badge {
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
  margin-right: 16rpx;
  margin-bottom: 8rpx;
  background: rgba(255, 255, 255, 0.2);
}

.doctor-status-badge.active {
  background: rgba(82, 196, 26, 0.8);
}

.doctor-status-badge.inactive {
  background: rgba(245, 108, 108, 0.8);
}

/* 信息区块 */
.info-section {
  margin: 30rpx;
  padding: 30rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  padding-left: 16rpx;
  border-left: 8rpx solid #2E8B57;
}

/* 基本信息网格 */
.info-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 30rpx;
}

.info-item {
  display: flex;
  flex-direction: column;
}

.info-label {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.info-value {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

/* 联系方式列表 */
.contact-list {
  display: flex;
  flex-direction: column;
}

.contact-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  position: relative;
}

.contact-item:last-child {
  border-bottom: none;
}

.contact-item text {
  margin-left: 20rpx;
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

/* 点击拨打提示 */
.tap-hint {
  font-size: 24rpx;
  color: #2E8B57;
  background-color: rgba(46, 139, 87, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 30rpx;
}

/* 快速拨打电话按钮 */
.quick-call-button {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #2E8B57;
  box-shadow: 0 4rpx 20rpx rgba(46, 139, 87, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0% {
    transform: scale(1);
    box-shadow: 0 4rpx 20rpx rgba(46, 139, 87, 0.4);
  }
  50% {
    transform: scale(1.05);
    box-shadow: 0 4rpx 30rpx rgba(46, 139, 87, 0.6);
  }
  100% {
    transform: scale(1);
    box-shadow: 0 4rpx 20rpx rgba(46, 139, 87, 0.4);
  }
}

/* 认证信息 */
.auth-status {
  display: flex;
  justify-content: center;
}

.auth-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 30rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
}

.auth-badge.verified {
  background-color: rgba(46, 139, 87, 0.1);
  color: #2E8B57;
}

.auth-badge.unverified {
  background-color: rgba(245, 108, 108, 0.1);
  color: #f56c6c;
}

.auth-badge text {
  margin-left: 10rpx;
}

/* 操作按钮 */
.action-group {
  display: flex;
  justify-content: space-between;
  padding: 30rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  border-radius: 12rpx;
  font-size: 30rpx;
  margin: 0 15rpx;
  border: none;
}

.action-btn text {
  margin-left: 12rpx;
}

.action-btn.contact {
  background-color: #2E8B57;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(46, 139, 87, 0.3);
}

.action-btn.unbind {
  background-color: #f56c6c;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(245, 108, 108, 0.3);
}

/* 无数据状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  background: #fff;
  margin: 30rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.empty-icon {
  margin-bottom: 40rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 20rpx;
}

.empty-sub-text {
  font-size: 28rpx;
  color: #999;
  text-align: center;
  margin-bottom: 60rpx;
}

.empty-action .action-button {
  background: #2E8B57;
  color: #fff;
  border: none;
  padding: 20rpx 60rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
} 