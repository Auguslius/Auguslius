/* pages/profile/profile.wxss */
.profile-container {
  min-height: 100vh;
  background-color: #f7f8fa;
  padding-bottom: 40rpx;
}

/* 用户卡片样式 */
.user-card {
  background-color: #2E8B57;
  color: #fff;
  padding: 40rpx 30rpx;
  border-radius: 0 0 30rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(46, 139, 87, 0.2);
}

.not-login {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 30rpx;
}

.avatar-placeholder {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.3);
  margin-bottom: 40rpx;
}

.login-btn-wrapper {
  margin-top: 20rpx;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  overflow: hidden;
  margin-right: 30rpx;
}

.avatar image {
  width: 100%;
  height: 100%;
}

.info {
  display: flex;
  flex-direction: column;
}

/* 用户名与认证标识行 */
.username-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.username {
  font-size: 36rpx;
  font-weight: bold;
  margin-right: 16rpx;
}

/* 认证状态标识样式 */
.auth-badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  background-color: rgba(255, 255, 255, 0.3);
  color: #fff;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.auth-badge.authenticated {
  background-color: #faad14;
  color: #ffffff;
}

.user-id {
  font-size: 24rpx;
  opacity: 0.8;
}

.user-data {
  display: flex;
  margin-top: 40rpx;
}

.data-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.number {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 6rpx;
}

.label {
  font-size: 24rpx;
  opacity: 0.8;
}

/* 菜单列表样式 */
.menu-list {
  background-color: #fff;
  border-radius: 16rpx;
  margin: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
  position: relative;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon-wrapper {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-icon {
  width: 40rpx;
  height: 40rpx;
  background-color: #f2f3f5;
  border-radius: 50%;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

/* 菜单项认证状态样式 */
.menu-auth-status {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  background-color: #f5f5f5;
  color: #999;
  margin-right: 16rpx;
}

.menu-auth-status.authenticated {
  background-color: #e6f7ff;
  color: #1890ff;
  border: 1rpx solid #91d5ff;
}

.menu-auth-status.not-authenticated {
  background-color: #fff7e6;
  color: #fa8c16;
  border: 1rpx solid #ffd591;
}

.menu-arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 2rpx solid #ccc;
  border-right: 2rpx solid #ccc;
  transform: rotate(45deg);
}

/* 退出登录按钮样式 */
.logout-wrapper {
  margin: 60rpx 30rpx 40rpx;
}

/* 版本信息样式 */
.version-info {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin-top: 40rpx;
}

/* 错误信息样式 */
.error-message {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #fff2f0;
  border: 1rpx solid #ffccc7;
  border-radius: 8rpx;
  margin: 20rpx;
  color: #f5222d;
}

.error-icon {
  margin-right: 10rpx;
  color: #f5222d;
  font-size: 40rpx;
}

/* 顶部错误提示框样式 */
.top-error-container {
  position: fixed;
  top: -100rpx;
  left: 0;
  right: 0;
  z-index: 1000;
  transition: top 0.3s ease-in-out;
}

.top-error-container.show {
  top: 0;
}

.top-error-content {
  background-color: #fff2f0;
  border-bottom: 1rpx solid #ffccc7;
  color: #f5222d;
  padding: 20rpx 30rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.top-error-icon {
  margin-right: 10rpx;
  font-size: 32rpx;
  color: #f5222d;
}

.top-error-close {
  margin-left: auto;
  font-size: 32rpx;
  color: #999;
}