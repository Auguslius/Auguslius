/* pages/health-record/health-record.wxss */
.health-record-container {
  padding: 30rpx;
  background-color: #f7f7f7;
  min-height: 100vh;
}

/* 页头样式 */
.header {
  margin-bottom: 30rpx;
  background-color: #fff;
  padding: 24rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.user-info {
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.user-id {
  font-size: 24rpx;
  color: #888;
}

/* 加载中样式 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-icon {
  width: 80rpx;
  height: 80rpx;
  border: 8rpx solid #e6e6e6;
  border-top: 8rpx solid #2E8B57;
  border-radius: 50%;
  margin-bottom: 30rpx;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 空数据样式 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  width: 180rpx;
  height: 180rpx;
  background-color: #eaeaea;
  border-radius: 50%;
  margin-bottom: 30rpx;
}

/* MMSE评估结果样式 */
.mmse-container {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 40rpx;
}

.section-title {
  margin-bottom: 30rpx;
}

.title-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.divider {
  height: 2rpx;
  background-color: #e6e6e6;
}

.section-container {
  margin-bottom: 40rpx;
}

.section-header {
  background-color: #f5f7fa;
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

.section-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #2E8B57;
}

.answers-list {
  padding: 0 10rpx;
}

.answer-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eaeaea;
}

.answer-item:last-child {
  border-bottom: none;
}

.question-info {
  display: flex;
  margin-bottom: 16rpx;
}

.question-position {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-right: 10rpx;
}

.question-type {
  font-size: 28rpx;
  color: #666;
}

.answer-content {
  display: flex;
  margin-bottom: 12rpx;
}

.answer-label {
  font-size: 28rpx;
  color: #666;
  min-width: 80rpx;
}

.answer-value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
  word-break: break-all;
}

.answer-details {
  padding-left: 80rpx;
}

.expected-answer {
  font-size: 24rpx;
  color: #999;
}

/* 媒体内容样式 */
.answer-media {
  margin-top: 16rpx;
  margin-bottom: 16rpx;
  padding-left: 80rpx;
}

.media-label {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 10rpx;
}

/* 音频容器样式 */
.audio-container {
  background-color: #f9f9f9;
  border-radius: 8rpx;
  padding: 16rpx;
  margin-top: 8rpx;
}

.audio-container audio {
  width: 100%;
}

/* 图片容器样式 */
.image-container {
  margin-top: 8rpx;
  text-align: center;
}

.answer-image {
  width: 90%;
  max-width: 500rpx;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* 底部注释 */
.footer-note {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-top: 40rpx;
} 